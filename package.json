{
  "name": "driftisle-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "浮屿工坊：原创局域网多人 3D 沙盒游戏",
  "type": "module",
  "scripts": {
    "build": "esbuild client/main.js --bundle --format=esm --minify --sourcemap --outfile=public/bundle.js",
    "start": "npm run build && node server/server.js",
    "dev": "npm run build && node --watch server/server.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
